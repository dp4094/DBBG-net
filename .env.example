# GlobalPointer NER 项目环境变量配置模板
# 
# 使用方法：
# 1. 复制此文件为 .env
# 2. 根据实际情况修改下面的值
# 3. 确保 .env 文件已添加到 .gitignore

# ============================================================================
# 数据路径配置
# ============================================================================

# 数据集根目录
# 默认值: ./datasets
DATA_HOME=./datasets

# 预训练模型目录
# 默认值: ./pretrained_models/bert-base-chinese
# 可选值: 
#   - ./pretrained_models/bert-base-chinese
#   - ./pretrained_models/Erlangshen-DeBERTa-v2-320M-Chinese
MODEL_HOME=./pretrained_models/Erlangshen-DeBERTa-v2-320M-Chinese

# ============================================================================
# 输出路径配置
# ============================================================================

# 训练输出目录（模型检查点、日志等）
# 默认值: ./outputs
OUTPUT_DIR=./outputs

# 评估结果目录
# 默认值: ./results
RESULTS_DIR=./results

# ============================================================================
# Weights & Biases 配置（可选）
# ============================================================================

# WandB API密钥（如果使用wandb日志记录）
# 获取方式: https://wandb.ai/authorize
# WANDB_API_KEY=your_api_key_here

# WandB项目名称
# WANDB_PROJECT=globalpointer-ner

# WandB实体名称（用户名或团队名）
# WANDB_ENTITY=your_username

# ============================================================================
# 其他配置
# ============================================================================

# Python路径（如果需要）
# PYTHONPATH=.

# CUDA设备ID（多GPU环境下指定使用的GPU）
# CUDA_VISIBLE_DEVICES=0

# ============================================================================
# 注意事项
# ============================================================================
# 
# 1. 路径配置：
#    - 使用相对路径时，相对于项目根目录
#    - 使用绝对路径时，确保路径存在
# 
# 2. 预训练模型：
#    - 需要手动下载预训练模型到指定目录
#    - 参考 pretrained_models/README.md 获取下载链接
# 
# 3. WandB配置：
#    - 只有在 config.py 中设置 logger="wandb" 时才需要
#    - 需要先注册 WandB 账号: https://wandb.ai/
# 
# 4. GPU配置：
#    - CUDA_VISIBLE_DEVICES 可以限制使用的GPU
#    - 例如: CUDA_VISIBLE_DEVICES=0,1 表示使用GPU 0和1
